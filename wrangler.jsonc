{
  // AMC Online — Cloudflare Worker (cf-port)
  //
  // First time?  cd cf && ./setup.sh   — provisions everything below, prompts
  //   for the secrets, and deploys. The manual steps here are the fallback.
  //
  // Deploy:  cd cf && npx wrangler deploy
  // Local:   cd cf && npx wrangler dev
  //
  // Provision the bindings once before first deploy:
  //   npx wrangler d1 create amc
  //   npx wrangler r2 bucket create amc-posters
  //   npx wrangler d1 execute amc --remote --file=schema.sql
  // then paste the printed database_id below.
  //
  // Secrets (not in this file):
  //   npx wrangler secret put AUTH_SECRET       (required — JWT/PBKDF2 key)
  //   npx wrangler secret put ENCRYPTION_SECRET (optional — separate key for
  //                                              encrypting stored credentials)
  //   npx wrangler secret put OMDB_API_KEY      (optional shared fallback only;
  //     the OMDb key is normally set per-user in-app under Settings)
  "name": "amc-online",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Served at a custom domain on the account's alpenglut.eu zone. `custom_domain`
  // makes Cloudflare create the DNS record + edge cert automatically.
  "routes": [{ "pattern": "amc.alpenglut.eu", "custom_domain": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amc",
      "database_id": "a9284840-4d6a-4e87-84b0-0e73b31d40f9",
      // Incremental schema changes live in cf/migrations/*.sql and are applied
      // with `wrangler d1 migrations apply amc --remote` (run it in the deploy
      // step — see package.json "deploy" and setup.sh). schema.sql is the baseline.
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "amc-posters"
    }
  ],

  // The built Vue frontend is served as static assets; the Worker handles /api/*.
  // Built by `npm run build` in cf/ (vite.config.ts) -> cf/dist.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "observability": { "enabled": true }
}
