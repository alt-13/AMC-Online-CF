{
  "name": "amc-cf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AMC Online — Cloudflare port (worker + browser modules)",
  "scripts": {
    "dev": "vite",
    "predev:worker": "node scripts/ensure-dist.mjs && node scripts/seed-local-db.mjs",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "migrate": "wrangler d1 migrations apply amc --remote",
    "deploy": "wrangler d1 migrations apply amc --remote && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mega": "vitest run browser/mega.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:app": "tsc -p tsconfig.app.json"
  },
  "dependencies": {
    "@primevue/themes": "^4.5.4",
    "megajs": "^1.3.7",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  }
}
